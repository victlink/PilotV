# ── 成果台运行时数据 ──────────────────────────────────────────────
# 成果库、已发布成果的副本、缩略图、验收截图都是本机状态，不进版本库。
# 备份脚本：scripts/purge_artifacts.py（只清表，不删库文件）
.artifacts-data/

# ── 凭据 ───────────────────────────────────────────────────────────
# console 口令 / 会话密钥 / API 令牌都在这里，由 scripts/start-console-tailscale.sh 读取。
# 绝不能进版本库。
.artifacts-secrets.env

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]

# 根级遗留 sqlite：现役库是 .artifacts-data/artifacts.db（artifacts_store.py:155），
# 代码里已无任何地方引用根级这个，留着只当历史文件。
/artifacts.db

# ── 服务端按需创建的目录（空目录 git 本来就不跟踪）──────────────────
/files/
/thumbs/

# ── PilotDeck 运行时 ───────────────────────────────────────────────
# 工具结果原文、单次运行的工作目录：随时可再生成。
.pilotdeck/tool-results/
.pilotdeck/work/

# ── 杂项 ───────────────────────────────────────────────────────────
*.log
*.pid

# ── 前端依赖与构建产物 ─────────────────────────────────────────────
# 775MB 的 node_modules 与 22MB 的 dist 都不进版本库，构建随时可复现。
node_modules/
dist/
.vite/
*.tsbuildinfo

# ── 临时目录 ──────────────────────────────────────────────────────
.tmp/

# ── 验收截图（可由脚本重新生成，不入库）──────────────────────────
pilotdeck-mobile/review/artifacts/
pilotdeck-mobile/scripts/weknora-e2e-shots/

# ── 网关运行时本机状态（含管理密钥，绝不入库）─────────────────────
# devices.local.json.secret 是网关的设备写操作会话密钥：
# 拿到它就能通过网关改设备清单、进而决定转发目标。
# devices.local.json.lock 是运行期锁文件。
# devices.local.json 是本机设备重命名/隐藏状态，属于个人偏好。
service/data/

# ── 部署与构建副产物（可重建，不入库）────────────────────────────
# 部署脚本每次先备份旧 dist，backup 目录会逐次累积到几十 MB。
.deployment-backups/
# vite build 前手动改名留下的旧产物目录，dist/ 规则匹配不到。
pilotdeck-mobile/upstream-official/ui/dist.previous-*/

# ── 脚本运行状态（一次性排查脚本的残留）──────────────────────────
scripts/.deploy_running_fixes_state.json

# ── 品牌动画 QA 截图（qa-*.py 随时可重新生成）────────────────────
design/logo/animated-frames/qa-*.png
# 拼出来的长图同理：跑一次 strip 脚本就能再造一份。
design/logo/animated-frames/frames.png
design/logo/frame-strip.png

# ── 组件截图探针的临时产物（verify_brand_component.py 每次重跑覆盖）──
.brand-verify/
.brand-verify-probe/

# ── 个人素材，不入库 ─────────────────────────────────────────────
/常用资料/

# 兜底：任何 .secret / *.secret 一律不入库
*.secret
