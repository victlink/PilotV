[Unit]
Description=PilotV Gateway (PilotDeck UI on __PORT__)
Documentation=file://__REPO_ROOT__/service/pilotv_gateway.mjs
After=network-online.target
Wants=network-online.target
# 崩了不限次数地拉起。注意：这一项属于 [Unit]，写进 [Service] 会被 systemd
# 当成未知键直接忽略 —— 限流一旦生效就会变成「崩五次后彻底不启动」。
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__REPO_ROOT__
Environment=HOME=__HOME__
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=LANG=en_US.UTF-8
# --- 监听 ---
Environment=UI_PORT=__PORT__
Environment=PILOTV_BIND=0.0.0.0
# --- HTTPS（安卓浏览器安装桌面应用的前提）---
# 安卓 Chrome 只在安全上下文里注册 Service Worker、才给安装入口。
# 两项都非空才启用；只给一半网关会拒绝启动，不会半 TLS 半明文地跑。
# 证书由 scripts/make_tls_cert.sh 生成。没有证书时这两行为空，网关走 http。
Environment=PILOTV_TLS_CERT=__TLS_CERT__
Environment=PILOTV_TLS_KEY=__TLS_KEY__
# --- 默认后端（本机 3001 由本机 PilotDeck 提供，这里只做反向代理，不强依赖）---
Environment=PILOTDECK_BACKEND=127.0.0.1:3001
# --- 前端构建产物与预置设备清单 ---
Environment=PILOTV_DIST=__REPO_ROOT__/pilotdeck-mobile/upstream-official/ui/dist
Environment=PILOTV_DEVICES=__REPO_ROOT__/pilotdeck-mobile/upstream-official/ui/public/devices.json
# --- 成果台（本机 8799 的 serve_artifacts.py，独立进程托管）---
Environment=PILOTV_ARTIFACTS_PER_DEVICE=1
Environment=PILOTV_ARTIFACTS_TARGET=http://127.0.0.1:__ARTIFACTS_PORT__
# --- 资料（WeKnora）---
Environment=PILOTV_WEKNORA_PORT=8080
# --- 设备写操作 ---
# 网关默认不允许改设备清单（能把新地址加进转发白名单，权限最大的入口）。
# 要用界面里的设备管理，必须在这里显式打开；凭据是首页种下的 pdv_admin
# 会话 Cookie，没配 PILOTV_ADMIN_TOKEN 时网关会自己在清单旁边生成一个随机密钥。
Environment=PILOTV_ALLOW_DEVICE_WRITES=1
ExecStart=__NODE__ __REPO_ROOT__/service/pilotv_gateway.mjs

# 崩了必拉起，且不限次数；日志落盘，事后能查死因。
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
StandardOutput=append:__HOME__/.pilotdeck/logs/pilotv-gateway.log
StandardError=append:__HOME__/.pilotdeck/logs/pilotv-gateway.log

[Install]
WantedBy=multi-user.target
