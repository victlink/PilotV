# 0007-config-ipc-test-runner.patch —— 配置通知不再打挂测试 runner
#
# 相对上游 vendor 的本地修复，可重放。
# 重放：git apply -p1 patches/0007-config-ipc-test-runner.patch
# 校验：node scripts/ci/check-upstream-patches.mjs
#
# 症状：在 vitest（或 node --test）里 import 到 ui/server/services/pilotdeckConfig.js
# 的测试文件全部跑不起来，报的是 vitest 内部 "Unexpected call to process.send()"，
# 离真正的原因（一个顺带对齐日志保留天数的通知）隔着好几层，很难查。
# 成因：applyConfigToProcessEnv() 用 process.connected 判断「有没有 IPC」，但测试
# runner 的 worker 也有 IPC，只是协议不同；那条消息让**父进程**反序列化失败，
# 子进程里的 try/catch 拦不住。
#
# 做法：测试 runner 下不发这条通知（VITEST / NODE_TEST_CONTEXT），并保留 try/catch
# 兜住同步抛错的宿主。通知本身就是尽力而为，配置早已写进 process.env。
#
# 效果：pilotv-pair 的 20 个用例（状态机 + 路由接线）从「整个文件跑不起来」变成全绿。
#
diff --git a/pilotdeck-mobile/upstream-official/ui/server/services/pilotdeckConfig.js b/pilotdeck-mobile/upstream-official/ui/server/services/pilotdeckConfig.js
index 971a35a..859b87c 100644
--- a/pilotdeck-mobile/upstream-official/ui/server/services/pilotdeckConfig.js
+++ b/pilotdeck-mobile/upstream-official/ui/server/services/pilotdeckConfig.js
@@ -751,11 +751,25 @@ export function buildRuntimeEnv(config) {
 export function applyConfigToProcessEnv(config) {
   Object.assign(process.env, buildRuntimeEnv(config));
   const days = setRuntimeLogRetention(config?.webui?.runtime?.logRetentionDays);
-  if (process.connected && typeof process.send === 'function') {
-    process.send({ type: 'pilotdeck:log-retention', days }, () => {});
+  if (process.connected && typeof process.send === 'function' && !runningUnderTestRunner()) {
+    // `process.connected` 只说明「有 IPC 通道」，不说明那条通道认我们的消息：
+    // 测试 runner 的 worker 也有 IPC，但它期望的是自己那套协议，收到这个对象
+    // 会在**父进程**里反序列化失败（子进程的 try/catch 拦不住），整轮测试直接
+    // 崩，报错还离真正的 import 很远。这里只是「顺手对齐日志保留天数」的旁支
+    // 通知，宿主不对就当没有 —— 配置本身已经在 env 里生效了。
+    try {
+      process.send({ type: 'pilotdeck:log-retention', days }, () => {});
+    } catch {
+      // 同步抛出的情况（宿主把 send 换成同步实现）同样忽略。
+    }
   }
 }
 
+/** vitest worker / node --test 子进程。两者的 IPC 通道都不是我们的 supervisor。 */
+function runningUnderTestRunner() {
+  return Boolean(process.env.VITEST) || process.env.NODE_TEST_CONTEXT !== undefined;
+}
+
 // ─── Memory service options ──────────────────────────────────────────────────
 
 export function buildMemoryLlmOptions(config) {
